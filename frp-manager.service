[Unit]
Description=FRP Client Management Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frp-manager
Group=frp-manager
WorkingDirectory=/opt/frp-manager
EnvironmentFile=/etc/default/frp-manager
ExecStart=/opt/frp-manager/frp-manager
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/frp-manager

[Install]
WantedBy=multi-user.target
